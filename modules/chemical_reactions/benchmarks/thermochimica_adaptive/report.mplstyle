font.family : Times
text.usetex : True
axes.titlesize : 12
axes.titleweight : bold
axes.labelsize : 12
lines.linewidth : 2
lines.markersize : 7.5
xtick.labelsize : 11
ytick.labelsize : 11
figure.labelsize : 12
pgf.preamble: \usepackage{siunitx} \usepackage{mhchem}

figure.dpi : 100
savefig.dpi : 300
savefig.bbox : tight
savefig.pad_inches : 0.05
savefig.transparent : True

axes.spines.top : False
axes.spines.right : False
axes.axisbelow : True
axes.grid : False
axes.linewidth : 0.8

grid.linewidth : 0.5
grid.alpha : 0.3

xtick.direction : in
ytick.direction : in
xtick.major.width : 0.8
ytick.major.width : 0.8
xtick.minor.width : 0.6
ytick.minor.width : 0.6

legend.frameon : False
legend.numpoints : 1
legend.scatterpoints : 1

pdf.fonttype : 42
ps.fonttype : 42
